# ========================================
# Backend-AI Environment Variables
# ========================================

# Modelos NLP
NLP_MODEL=es_core_news_lg
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Matching
MATCHING_THRESHOLD_APTO=80.0
MATCHING_THRESHOLD_REVISION=60.0
MAX_BATCH_SIZE=50
TIMEOUT_SECONDS=30

# Ponderaciones
PESO_ESCOLARIDAD=0.30
PESO_EXPERIENCIA=0.35
PESO_CURSOS=0.15
PESO_HABILIDADES=0.20

# Anonimizacion
ANONIMIZACION_CONFIANZA_MINIMA=0.85

# CORS
CORS_ORIGINS=["http://localhost:3007","http://localhost:8087"]

# Logging
LOG_LEVEL=INFO
DEBUG=false