# ========================================
# VARIABLES DE ENTORNO GENERALES
# ========================================
# Copia este archivo como .env y completa los valores
# NUNCA subas el archivo .env real a Git

# Entorno (dev, staging, prod)
ENVIRONMENT=dev

# ========================================
# FRONTEND (Next.js)
# ========================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=Gestiona-T
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================
# BACKEND CORE (Spring Boot)
# ========================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestiona_t
DB_USER=gestiona_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MinIO Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documentos

# JWT
JWT_SECRET=CHANGE_ME_SUPER_SECRET_KEY_MIN_256_BITS
JWT_EXPIRATION_MS=3600000

# APIs Externas (Credenciales oficiales)
RENAPO_API_URL=https://api.renapo.gob.mx/v1
RENAPO_API_KEY=CHANGE_ME
RENAPO_API_SECRET=CHANGE_ME

RNP_API_URL=https://api.rnp.sep.gob.mx/v1
RNP_API_KEY=CHANGE_ME

SAT_API_URL=https://api.sat.gob.mx/v1
SAT_API_KEY=CHANGE_ME

SFP_API_URL=https://api.sfp.gob.mx/v1
SFP_API_KEY=CHANGE_ME

INE_LISTA_NOMINAL_URL=https://api.ine.mx/lista-nominal/v1
INE_API_KEY=CHANGE_ME

# ========================================
# BACKEND IA (FastAPI)
# ========================================
AI_SERVER_PORT=8000
AI_LOG_LEVEL=INFO

# Modelos ML
ML_MODELS_PATH=./app/ml/models
MATCHING_THRESHOLD=70
ANONYMIZATION_CONFIDENCE=0.85

# OCR
OCR_ENGINE=tesseract
OCR_LANGUAGE=spa

# ========================================
# SEGURIDAD
# ========================================
# Cifrado
ENCRYPTION_KEY=CHANGE_ME_AES_256_KEY
ENCRYPTION_ALGORITHM=AES-256-GCM

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ========================================
# AUDITORÍA
# ========================================
AUDIT_LOG_RETENTION_DAYS=3650
AUDIT_BLOCKCHAIN_ENABLED=false
AUDIT_BLOCKCHAIN_URL=http://localhost:8545

# ========================================
# NOTIFICACIONES
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@ine.mx
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@ine.mx

SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=CHANGE_ME
SMS_AUTH_TOKEN=CHANGE_ME
SMS_FROM_NUMBER=+525512345678

# ========================================
# ACCESIBILIDAD
# ========================================
TTS_ENABLED=true
TTS_PROVIDER=azure
TTS_API_KEY=CHANGE_ME
LSM_VIDEO_ENABLED=true